{
  "expo": {
    "name": "Cinelog",
    "slug": "Cinelog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./applogo.png",
    "scheme": "cinelog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./applogo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020D19",
        "foregroundImage": "./applogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Cinelog",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./applogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020D19",
          "image": "./trlogo.png",
          "imageWidth": 200
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6858de2d-7612-4bf2-8327-d0af696cecc7"
      }
    }
  }
}
